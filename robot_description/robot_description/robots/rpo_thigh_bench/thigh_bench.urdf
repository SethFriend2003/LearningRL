<?xml version="1.0"?>
<!--
  PACE bench rig: one RPO thigh actuator (DM-J10010L), axis VERTICAL (+z), so gravity puts no
  torque on the joint. bracket_link is the bare thigh bracket (NO knee motor) on the output flange.

  bracket_link: CAD inertia of the bare bracket about the motor axis, 8469.549 kg*mm^2
  (team CAD, 2026-11-19). Fixed base + vertical axis: only that inertia enters the dynamics, so
  the CoM sits on the axis and izz is the CAD value. Mass is NOT measured and has no effect here;
  ixx = iyy = izz / 2 only keep the tensor physical. Any izz error is absorbed into armature.
-->
<robot name="rpo_thigh_bench">
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <geometry><cylinder radius="0.06" length="0.05"/></geometry>
    </visual>
  </link>

  <joint name="thigh_bench_joint" type="revolute">
    <parent link="base_link"/>
    <child link="bracket_link"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <!-- rpo.urdf thigh joint effort/velocity class (120 N*m, 25 rad/s) -->
    <limit lower="-3.14" upper="3.14" effort="120" velocity="25"/>
  </joint>

  <link name="bracket_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.0042347745" ixy="0" ixz="0" iyy="0.0042347745" iyz="0" izz="0.008469549"/>
    </inertial>
    <visual>
      <origin xyz="0.12 0 0" rpy="0 0 0"/>
      <geometry><box size="0.24 0.04 0.02"/></geometry>
    </visual>
  </link>
</robot>
